#!/usr/bin/env bash
# lunar-chroot: find the Linux systems installed on this computer, mount the
# one you pick together with everything in its /etc/fstab (/home, /boot, the
# EFI partition, Btrfs subvolumes, ...) and open a root shell inside it with
# arch-chroot. Meant for repairs from the live system: reinstall the boot
# loader, rebuild the initramfs, fix a broken update, reset a password.
#
#   lunar-chroot                      find systems, ask which one, chroot
#   lunar-chroot /dev/nvme0n1p2       use this partition (or LUKS/LVM device)
#   lunar-chroot -- mkinitcpio -P     run a command instead of a shell
#   lunar-chroot --list               only show the systems found
#   lunar-chroot --keep               leave everything mounted after exit
#   lunar-chroot --umount             unmount what --keep left mounted
#
# Options:
#   -s, --subvol NAME   Btrfs: use this subvolume as / (default: the one with
#                       the system on it, usually @)
#   -m, --mount DIR     mount the system here (default /mnt/lunar)
#   -k, --keep          leave it mounted and unlocked after the shell exits;
#                       running lunar-chroot again goes straight back in
#   -l, --list          list the systems found and exit
#       --snapshots     also offer Btrfs snapshots (snapper, timeshift)
#   -u, --umount        unmount DIR and exit
#   -h, --help          show this help
#
# Root file systems: ext2/3/4, XFS, Btrfs (any subvolume layout) and F2FS, on
# plain partitions, LUKS, LVM and mdadm RAID. Encrypted partitions are
# unlocked first (you are asked for each one); disks listed in the system's
# /etc/crypttab are unlocked with their key files where possible.
set -uo pipefail

if [[ $EUID -ne 0 ]]; then
    exec sudo -- "$0" "$@"
fi

mnt=/mnt/lunar
subvol=
subvol_set=0
keep=0
list_only=0
snapshots=0
do_umount=0
device=
cmd=()

if [[ -t 2 ]]; then
    B=$'\e[1m' BLUE=$'\e[1;34m' GREEN=$'\e[1;32m' YELLOW=$'\e[1;33m' RED=$'\e[1;31m' N=$'\e[0m'
else
    B='' BLUE='' GREEN='' YELLOW='' RED='' N=''
fi
msg()  { printf '%s==>%s %s%s%s\n' "$GREEN" "$N" "$B" "$*" "$N" >&2; }
msg2() { printf '  %s->%s %s\n' "$BLUE" "$N" "$*" >&2; }
warn() { printf '%s==> WARNING:%s %s\n' "$YELLOW" "$N" "$*" >&2; }
die()  { printf '%s==> ERROR:%s %s\n' "$RED" "$N" "$*" >&2; exit 1; }
usage() { sed -n '2,/^set -uo/p' "$0" | sed -e '$d' -e 's/^# \{0,1\}//'; }

while [[ $# -gt 0 ]]; do
    case "$1" in
        -s|--subvol) [[ $# -ge 2 ]] || die "$1 needs a value"; subvol="${2#/}"; subvol_set=1; shift ;;
        -m|--mount)  [[ $# -ge 2 ]] || die "$1 needs a value"; mnt="${2%/}"; shift ;;
        -k|--keep)   keep=1 ;;
        -l|--list)   list_only=1 ;;
        --snapshots) snapshots=1 ;;
        -u|--umount) do_umount=1 ;;
        -h|--help)   usage; exit 0 ;;
        --)          shift; cmd=("$@"); break ;;
        -*)          die "unknown option $1 (see lunar-chroot --help)" ;;
        *)           [[ -z "$device" ]] || die "only one device can be given"; device="$1" ;;
    esac
    shift
done
[[ "$mnt" == /?* ]] || die "the mount folder must be an absolute path other than /"
for c in arch-chroot lsblk findmnt mount umount; do
    command -v "$c" >/dev/null || die "'$c' is missing (pacman -S arch-install-scripts util-linux)"
done

# ---------------------------------------------------------------- helpers

has() { command -v "$1" >/dev/null 2>&1; }

# Questions go to the terminal (stdin may be a pipe); without one, locked
# disks are skipped.
have_tty=0
{ : </dev/tty; } 2>/dev/null && have_tty=1

# Undo our mounts and unlocks on exit (unless --keep).
opened_luks=()   # mapper names we opened
our_vgs=()       # volume groups we activated
scan_dir=
# --keep remembers what it unlocked here, for --umount
state="/run/lunar-chroot.$(printf '%s' "$mnt" | tr -c 'A-Za-z0-9' '_').state"
cleanup() {
    local rc=$? vg i
    trap - INT TERM
    if [[ -n "$scan_dir" ]]; then
        mountpoint -q "$scan_dir" && umount "$scan_dir" 2>/dev/null
        rmdir "$scan_dir" 2>/dev/null
    fi
    # volume groups that were switched off before we started
    if [[ -n "${vgs_before+x}" ]]; then
        while IFS= read -r vg; do
            [[ -n "$vg" ]] && ! grep -qxF "$vg" <<<"$vgs_before" && our_vgs+=("$vg")
        done < <(active_vgs)
    fi
    if [[ $keep -eq 1 ]] && mountpoint -q "$mnt"; then
        if [[ $(( ${#our_vgs[@]} + ${#opened_luks[@]} )) -gt 0 ]]; then
            { for vg in "${our_vgs[@]}"; do echo "vg $vg"; done
              for i in "${opened_luks[@]}"; do echo "luks $i"; done; } >> "$state"
        fi
        msg "Left mounted at $mnt"
        msg2 "go back in: lunar-chroot      unmount and lock: lunar-chroot --umount"
        exit "$rc"
    fi
    if mountpoint -q "$mnt"; then
        msg "Unmounting $mnt"
        sync
        if ! umount -R "$mnt" 2>/dev/null; then
            sleep 1
            umount -R "$mnt" 2>/dev/null || {
                warn "$mnt is busy, detaching it lazily (it goes away once nothing uses it)"
                umount -R -l "$mnt"
            }
        fi
    fi
    for vg in "${our_vgs[@]}"; do vgchange -an "$vg" >/dev/null 2>&1; done
    for (( i=${#opened_luks[@]}-1; i>=0; i-- )); do
        cryptsetup close "${opened_luks[i]}" 2>/dev/null \
            || warn "could not lock ${opened_luks[i]} again (still in use?)"
    done
    exit "$rc"
}
trap cleanup EXIT
trap 'exit 130' INT TERM

# lsblk -P line -> variables (no eval: device data is not trusted)
lsblk_field() {  # <line> <KEY>
    local re="(^| )$2=\"([^\"]*)\""
    [[ "$1" =~ $re ]] && printf '%s' "${BASH_REMATCH[2]}"
}

# The disk the live system booted from: never offered, never unlocked.
live_disks=()
for m in /run/archiso/bootmnt /run/archiso/cowspace; do
    src="$(findmnt -nro SOURCE "$m" 2>/dev/null)" || continue
    [[ -b "$src" ]] || continue
    live_disks+=("$(lsblk -ndpo PKNAME "$src" 2>/dev/null | head -n1)" "$src")
done
on_live_disk() {
    local d p
    [[ ${#live_disks[@]} -gt 0 ]] || return 1
    for p in $(lsblk -nrpso NAME "$1" 2>/dev/null); do
        for d in "${live_disks[@]}"; do [[ -n "$d" && "$p" == "$d" ]] && return 0; done
    done
    return 1
}

# Read PRETTY_NAME from a mounted root without following absolute symlinks
# out of it (etc/os-release usually points at /usr/lib/os-release).
os_name() {
    local root="$1" f name
    for f in "$root/usr/lib/os-release" "$root/etc/os-release"; do
        [[ -f "$f" && ! -L "$f" ]] || continue
        name="$(sed -n 's/^PRETTY_NAME=//p' "$f" | head -n1 | tr -d "\"'")"
        [[ -n "$name" ]] || name="$(sed -n 's/^NAME=//p' "$f" | head -n1 | tr -d "\"'")"
        printf '%s' "${name:-Linux}"
        return 0
    done
    return 1
}

# Mount read-only without replaying journals (we only look).
scan_mount() {  # <dev> <fstype> [extra opts]
    local dev="$1" fs="$2" extra="${3:+,$3}"
    case "$fs" in
        ext2|ext3|ext4) mount -t "$fs" -o "ro,noload$extra" "$dev" "$scan_dir" 2>/dev/null && return 0 ;;
        xfs)            mount -t xfs -o "ro,norecovery$extra" "$dev" "$scan_dir" 2>/dev/null && return 0 ;;
    esac
    mount -t "$fs" -o "ro$extra" "$dev" "$scan_dir" 2>/dev/null
}

# ---------------------------------------------------------------- --umount

if [[ $do_umount -eq 1 ]]; then
    keep=0
    if [[ -f "$state" ]]; then
        while read -r kind name; do
            case "$kind" in vg) our_vgs+=("$name") ;; luks) opened_luks+=("$name") ;; esac
        done < "$state"
        rm -f "$state"
    fi
    mountpoint -q "$mnt" || msg "Nothing is mounted at $mnt"
    exit 0   # cleanup unmounts and locks
fi

# Already mounted by an earlier --keep run: go straight back in.
if mountpoint -q "$mnt" && [[ -z "$device" && $list_only -eq 0 ]]; then
    msg "Using what is already mounted at $mnt"
    keep=1
    trap : INT
    arch-chroot "$mnt" "${cmd[@]}"
    exit $?
fi
mountpoint -q "$mnt" && die "$mnt is already in use - run lunar-chroot --umount, or pick another folder with --mount"

# ---------------------------------------------------------------- unlock

# mdadm RAID and LVM first (LUKS may sit on either), then LUKS, then LVM again
# (LVM may sit inside LUKS).
has mdadm && mdadm --assemble --scan >/dev/null 2>&1

active_vgs() { has lvs && lvs --noheadings -o vg_name -S lv_active=active 2>/dev/null | tr -d ' ' | sort -u; }
vgs_before="$(active_vgs)"
activate_lvm() {
    has vgchange || return 0
    vgscan --mknodes >/dev/null 2>&1
    vgchange -ay >/dev/null 2>&1
}
activate_lvm

open_luks() {  # <dev> <name> [keyfile]
    local dev="$1" name="$2" key="${3:-}"
    if [[ -n "$key" ]]; then
        cryptsetup open --key-file "$key" "$dev" "$name" 2>/dev/null || return 1
    else
        cryptsetup open --tries 3 "$dev" "$name" || return 1
    fi
    opened_luks+=("$name")
}

unlock_all() {
    has cryptsetup || return 0
    local line dev uuid size label ans
    local only=
    if [[ -n "$device" ]]; then
        # a device was named: only unlock it, if it is LUKS itself
        only="$(readlink -f "$device")"
        [[ -b "$only" ]] || die "$device is not a block device (a locked LUKS or LVM volume? name the encrypted partition instead)"
    fi
    while IFS= read -r -u 3 line; do
        dev="$(lsblk_field "$line" NAME)"
        [[ "$(lsblk_field "$line" FSTYPE)" == crypto_LUKS ]] || continue
        [[ -z "$only" || "$(readlink -f "$dev")" == "$only" ]] || continue
        on_live_disk "$dev" && continue
        # already open?
        lsblk -nrpo TYPE "$dev" | tail -n +2 | grep -qx crypt && continue
        uuid="$(cryptsetup luksUUID "$dev" 2>/dev/null)" || continue
        size="$(lsblk_field "$line" SIZE)"
        label="$(lsblk_field "$line" PARTLABEL)"
        (( have_tty )) && read -r -p "Unlock encrypted partition $dev ($size${label:+, $label})? [Y/n] " ans </dev/tty || ans=n
        [[ "$ans" =~ ^[Nn] ]] && continue
        # Same name the installer and systemd use, so fstab entries match.
        open_luks "$dev" "luks-$uuid" || warn "could not unlock $dev, skipping it"
    done 3< <(lsblk -Ppno NAME,FSTYPE,SIZE,PARTLABEL)
}
unlock_all
activate_lvm

# ---------------------------------------------------------------- scan

c_dev=() c_fs=() c_sub=() c_name=() c_size=()
add_candidate() { c_dev+=("$1") c_fs+=("$2") c_sub+=("$3") c_name+=("$4") c_size+=("$5"); }

is_snapshot() {
    [[ $snapshots -eq 1 ]] && return 1
    # snapper (@/.snapshots/N/snapshot, @snapshots/N/snapshot), timeshift
    [[ "$1" == *snapshots/* || "$1" == timeshift-btrfs/* ]]
}

scan_dir="$(mktemp -d /run/lunar-chroot-scan.XXXXXX)" || die "could not create a scan folder"
seen_btrfs=" "
msg "Looking for installed systems"
while IFS= read -r line; do
    dev="$(lsblk_field "$line" NAME)"
    fs="$(lsblk_field "$line" FSTYPE)"
    type="$(lsblk_field "$line" TYPE)"
    size="$(lsblk_field "$line" SIZE)"
    case "$type" in loop|rom) continue ;; esac
    case "$fs" in ext2|ext3|ext4|xfs|btrfs|f2fs) ;; *) continue ;; esac
    [[ "$dev" == /dev/zram* ]] && continue
    on_live_disk "$dev" && continue
    if [[ -n "$(lsblk_field "$line" MOUNTPOINT)" ]]; then
        msg2 "$dev is in use by the running system, skipping it"
        continue
    fi

    if [[ "$fs" == btrfs ]]; then
        uuid="$(lsblk_field "$line" UUID)"
        [[ "$seen_btrfs" == *" $uuid "* ]] && continue   # multi-device btrfs
        seen_btrfs+="$uuid "
        has btrfs && btrfs device scan >/dev/null 2>&1
        scan_mount "$dev" btrfs subvolid=5 || continue
        default="$(btrfs subvolume get-default "$scan_dir" 2>/dev/null | sed -n 's/.* path //p')"
        subs=()
        [[ -n "$default" ]] && subs+=("$default")
        while IFS= read -r s; do
            [[ "$s" == "$default" ]] || subs+=("$s")
        done < <(btrfs subvolume list "$scan_dir" 2>/dev/null | sed -n 's/.* path //p')
        subs+=("")   # the top level itself
        for s in "${subs[@]}"; do
            [[ -n "$s" ]] && is_snapshot "$s" && continue
            name="$(os_name "$scan_dir${s:+/$s}")" || continue
            add_candidate "$dev" btrfs "$s" "$name" "$size"
        done
        umount "$scan_dir"
    else
        scan_mount "$dev" "$fs" || continue
        name="$(os_name "$scan_dir")" && add_candidate "$dev" "$fs" "" "$name" "$size"
        umount "$scan_dir"
    fi
done < <(lsblk -Ppno NAME,FSTYPE,TYPE,SIZE,UUID,MOUNTPOINT)
rmdir "$scan_dir"; scan_dir=

describe() {  # <index>
    local i="$1" where="${c_fs[$1]}"
    [[ "${c_fs[i]}" == btrfs ]] && where+=", subvolume ${c_sub[i]:-<top level>}"
    printf '%s%s%s  on %s (%s, %s)' "$B" "${c_name[i]}" "$N" "${c_dev[i]}" "$where" "${c_size[i]}"
}

# Filter by the device / subvolume given on the command line.
if [[ -n "$device" ]]; then
    want="$(readlink -f "$device")"
    # The device itself and everything on it (LUKS -> LVM -> volume), by
    # path and by file system UUID (any member of a multi-device btrfs).
    want_paths=" " want_uuids=" "
    while read -r p u; do
        want_paths+="$(readlink -f "$p") "
        [[ -n "$u" ]] && want_uuids+="$u "
    done < <(lsblk -nrpo NAME,UUID "$want" 2>/dev/null)
    keep_idx=()
    for i in "${!c_dev[@]}"; do
        u="$(lsblk -ndo UUID "${c_dev[i]}" 2>/dev/null)"
        if [[ "$want_paths" == *" $(readlink -f "${c_dev[i]}") "* ]] \
           || [[ -n "$u" && "$want_uuids" == *" $u "* ]]; then
            keep_idx+=("$i")
        fi
    done
    # Also allow a device whose system we could not recognise when --subvol
    # is given (e.g. a broken os-release).
    [[ ${#keep_idx[@]} -gt 0 || $subvol_set -eq 1 ]] \
        || die "no installed system found on $device (lunar-chroot --list shows what was found)"
    if [[ ${#keep_idx[@]} -eq 0 ]]; then
        add_candidate "$want" "$(lsblk -ndo FSTYPE "$want")" "$subvol" "unknown system" "$(lsblk -ndo SIZE "$want")"
        keep_idx=($(( ${#c_dev[@]} - 1 )))
    fi
else
    keep_idx=("${!c_dev[@]}")
fi
if [[ $subvol_set -eq 1 ]]; then
    sel=()
    for i in "${keep_idx[@]}"; do [[ "${c_sub[i]}" == "$subvol" ]] && sel+=("$i"); done
    if [[ ${#sel[@]} -eq 0 ]]; then
        # e.g. a snapshot that was filtered out: take it on trust
        i="${keep_idx[0]:-}"
        [[ -n "$i" && "${c_fs[i]}" == btrfs ]] || die "--subvol only works with a Btrfs system"
        add_candidate "${c_dev[i]}" btrfs "$subvol" "${c_name[i]}" "${c_size[i]}"
        sel=($(( ${#c_dev[@]} - 1 )))
    fi
    keep_idx=("${sel[@]}")
fi

if [[ ${#keep_idx[@]} -eq 0 ]]; then
    warn "No installed Linux system found."
    msg2 "Disks seen:"
    lsblk -o NAME,SIZE,FSTYPE,MOUNTPOINTS,PARTLABEL -e 7,11 >&2
    msg2 "Encrypted disks you skipped are not searched; a root on ZFS or bcachefs is not supported."
    exit 1
fi

if [[ $list_only -eq 1 ]]; then
    for n in "${!keep_idx[@]}"; do printf '  %d) %s\n' $((n+1)) "$(describe "${keep_idx[n]}")"; done
    exit 0
fi

if [[ ${#keep_idx[@]} -eq 1 ]]; then
    pick="${keep_idx[0]}"
    msg "Found $(describe "$pick")"
else
    msg "Found ${#keep_idx[@]} systems:"
    for n in "${!keep_idx[@]}"; do printf '  %d) %s\n' $((n+1)) "$(describe "${keep_idx[n]}")" >&2; done
    while :; do
        (( have_tty )) || die "several systems found and no terminal to ask on - name one: lunar-chroot DEVICE"
        read -r -p "Which one? [1-${#keep_idx[@]}, default 1, q to quit] " ans </dev/tty || exit 1
        ans="${ans:-1}"
        [[ "$ans" == [qQ]* ]] && exit 0
        if [[ "$ans" =~ ^[0-9]+$ ]] && (( ans >= 1 && ans <= ${#keep_idx[@]} )); then
            pick="${keep_idx[ans-1]}"; break
        fi
        echo "Please enter a number between 1 and ${#keep_idx[@]}." >&2
    done
fi

# ---------------------------------------------------------------- mount

root_dev="${c_dev[pick]}" root_fs="${c_fs[pick]}" root_sub="${c_sub[pick]}"
mkdir -p "$mnt"
root_opts=rw
if [[ "$root_fs" == btrfs ]]; then
    if [[ -n "$root_sub" ]]; then root_opts+=",subvol=/$root_sub"; else root_opts+=",subvolid=5"; fi
fi
msg "Mounting $root_dev at $mnt"
mount -t "$root_fs" -o "$root_opts" "$root_dev" "$mnt" \
    || die "could not mount $root_dev (a file system check may help: fsck / xfs_repair / btrfs check)"

# Disks in the system's crypttab that are still locked (e.g. a second disk
# for /home, unlocked at boot with a key file stored on the root).
crypttab="$mnt/etc/crypttab"
if [[ -f "$crypttab" ]] && has cryptsetup; then
    while read -r -u 3 name src key _; do
        [[ -z "$name" || "$name" == \#* ]] && continue
        [[ -e "/dev/mapper/$name" ]] && continue
        case "$src" in
            UUID=*)     src="/dev/disk/by-uuid/${src#UUID=}" ;;
            PARTUUID=*) src="/dev/disk/by-partuuid/${src#PARTUUID=}" ;;
            LABEL=*)    src="/dev/disk/by-label/${src#LABEL=}" ;;
        esac
        [[ -b "$src" ]] || continue
        cryptsetup isLuks "$src" 2>/dev/null || continue
        # skip devices that are already open under another name
        lsblk -nrpo TYPE "$src" | tail -n +2 | grep -qx crypt && continue
        if [[ -n "$key" && "$key" != none && "$key" != - && "$key" == /* && -f "$mnt$key" ]]; then
            msg2 "unlocking $name with key file $key"
            open_luks "$src" "$name" "$mnt$key" && continue
        fi
        (( have_tty )) && read -r -p "Unlock $name ($src) from crypttab? [Y/n] " ans </dev/tty || ans=n
        [[ "$ans" =~ ^[Nn] ]] || open_luks "$src" "$name" || warn "could not unlock $name"
    done 3< "$crypttab"
    activate_lvm
fi

# Everything else from the system's fstab, parents before children.
fstab="$mnt/etc/fstab"
if [[ -f "$fstab" && "$root_fs" == btrfs ]]; then
    # the root's own options (compress=..., noatime) as the system uses them
    ropts="$(findmnt -n --fstab --tab-file "$fstab" -o OPTIONS --target / 2>/dev/null | head -n1 \
             | tr ',' '\n' | grep -Ev '^(subvol|subvolid)=|^(ro|rw|defaults|x-.*)$' | paste -sd,)"
    [[ -n "$ropts" ]] && mount -o "remount,$ropts" "$mnt" 2>/dev/null
fi
if [[ -f "$fstab" ]]; then
    while IFS=$'\t' read -r _ src tgt fstype opts; do
        src="$(printf '%b' "$src")" tgt="$(printf '%b' "$tgt")"
        [[ "$tgt" == /?* ]] || continue                  # / itself, swap
        [[ ",$opts," == *,noauto,* ]] && continue
        case "$fstype" in
            swap|proc|sysfs|devpts|devtmpfs|tmpfs|efivarfs|securityfs|cgroup*|debugfs|tracefs|configfs|mqueue|hugetlbfs) continue ;;
            nfs*|cifs|smb3|sshfs|fuse*|9p|virtiofs|davfs) msg2 "skipping network/FUSE mount $tgt"; continue ;;
        esac
        [[ ",$opts," == *,_netdev,* ]] && { msg2 "skipping network mount $tgt"; continue; }
        mountpoint -q "$mnt$tgt" && continue
        if [[ ",$opts," == *,bind,* || ",$opts," == *,rbind,* ]]; then
            mkdir -p "$mnt$tgt"
            mount --bind "$mnt$src" "$mnt$tgt" && msg2 "$tgt (bind of $src)" || warn "could not bind $src to $tgt"
            continue
        fi
        # --evaluate turned UUID=... into a path; if not, the disk is missing
        if [[ ! -b "$src" ]]; then
            warn "$tgt: $src not found (a locked or missing disk?), skipping it"
            continue
        fi
        mkdir -p "$mnt$tgt"
        if mount -t "$fstype" -o "$opts" "$src" "$mnt$tgt"; then
            msg2 "$tgt ($src, $fstype)"
        else
            warn "could not mount $tgt ($src), skipping it"
        fi
    done < <(findmnt -rn --fstab --tab-file "$fstab" --evaluate -o SOURCE,TARGET,FSTYPE,OPTIONS 2>/dev/null \
             | while read -r s t f o; do
                   d="${t//[^\/]/}"; printf '%d\t%s\t%s\t%s\t%s\n' "${#d}" "$s" "$t" "$f" "$o"
               done | sort -s -n -k1,1)
else
    warn "$root_dev has no /etc/fstab; only / is mounted"
fi

# ---------------------------------------------------------------- chroot

echo >&2
findmnt -R -o TARGET,SOURCE,FSTYPE "$mnt" >&2
echo >&2
if [[ ${#cmd[@]} -eq 0 ]]; then
    msg "Entering ${c_name[pick]} - type 'exit' or press Ctrl+D to leave"
    msg2 "common repairs: pacman -Syu | mkinitcpio -P | bootctl install | passwd <user>"
fi
# Ctrl+C belongs to the shell inside; a no-op handler (not '' - that would be
# inherited) keeps it from ending this script before the shell exits.
trap : INT
arch-chroot "$mnt" "${cmd[@]}"
exit $?
