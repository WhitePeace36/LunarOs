# Lunar: the desktop wallpaper "Wordmark Lockup" (branding/20-wordmark-lockup.png,
# package lunar-wallpapers) also on the lock screen. A wallpaper the user picks
# (System Settings > Screen Locking) goes into ~/.config/kscreenlockerrc and
# wins over this one.
[Greeter]
WallpaperPlugin=org.kde.image

[Greeter][Wallpaper][org.kde.image][General]
Image=file:///usr/share/wallpapers/lunar-wordmark-lockup/
PreviewImage=file:///usr/share/wallpapers/lunar-wordmark-lockup/
