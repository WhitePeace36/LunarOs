# Lunar: Dolphin shows every folder the same way: as a list with details
# (name, size, modified) at the smallest zoom, folders that expand into a
# tree, hidden files visible. The view itself (details, hidden files) is in
# /etc/skel/.local/share/dolphin/view_properties/global/.directory, which
# Dolphin only reads from the user's home.
[General]
GlobalViewProps=true

# IconSize is the zoom without previews, PreviewSize the one with previews
[DetailsMode]
ExpandableFolders=true
IconSize=16
PreviewSize=16
