# Maintainer: Timon <timon2201@gmail.com>
#
# Lunar's defaults for Brave and LibreWolf:
#
# Brave (/etc/brave/policies, Chromium policies; check them in brave://policy)
#   managed/lunar.json      enforced, because Brave/Chromium allow these only as
#                           enforced policies:
#                           - DNS over HTTPS "automatic" with Quad9 (falls back to
#                             the system's DNS); Chromium turns DoH off on managed
#                             browsers unless this policy is set
#                           - Shields: HTTPS upgrade "strict" (HTTPS only, all windows)
#                           - fingerprinting protection off
#   recommended/lunar.json  defaults the user can change: bookmarks bar shown,
#                           no "save password?", no saving/filling payment
#                           methods, DuckDuckGo
#   /opt/brave-bin/initial_preferences
#                           first start of a new profile: imports
#                           /usr/share/lunar-browser-settings/bookmarks.html
#                           (Youtube on the bookmarks bar)
#   Dark mode: no policy; Brave follows the system theme (Breeze Dark on Lunar).
#   uBlock Origin: Brave only offers it at brave://settings/extensions/v2 (served
#   by Brave since the Chrome Web Store dropped it); Shields block ads by default.
#
# LibreWolf
#   /etc/skel/.config/librewolf/librewolf/librewolf.overrides.cfg (read after
#   LibreWolf's librewolf.cfg; new users get it): DNS over HTTPS "increased
#   protection" (Quad9), resistFingerprinting off, dark websites.
#   /etc/librewolf/policies/policies.json, written by /usr/lib/lunar/librewolf-policies
#   (pacman hook) from LibreWolf's own policies plus librewolf-policies.json:
#   bookmarks toolbar shown, new profiles start with bookmarks.html (Youtube).
#   LibreWolf itself already ships uBlock Origin, DuckDuckGo, HTTPS-only mode,
#   no password saving, no payment autofill and no default bookmarks.

pkgname=lunar-browser-settings
pkgver=1.1.0
pkgrel=1
pkgdesc='Lunar - Brave and LibreWolf defaults (DNS over HTTPS, HTTPS only, no password/payment saving, DuckDuckGo, fingerprinting protection off, bookmarks bar with Youtube)'
arch=('any')
url='https://github.com/WhitePeace36/LunarOs'
license=('GPL-2.0-only')
depends=('jq')
optdepends=('brave-bin: uses /etc/brave/policies and initial_preferences'
            'librewolf: uses the overrides and the merged policies')
backup=('etc/brave/policies/managed/lunar.json'
        'etc/brave/policies/recommended/lunar.json'
        'etc/skel/.config/librewolf/librewolf/librewolf.overrides.cfg')
install=lunar-browser-settings.install

package() {
  local f
  for f in etc/brave/policies/managed/lunar.json \
           etc/brave/policies/recommended/lunar.json \
           etc/skel/.config/librewolf/librewolf/librewolf.overrides.cfg \
           opt/brave-bin/initial_preferences \
           usr/share/lunar-browser-settings/bookmarks.html \
           usr/share/lunar-browser-settings/librewolf-policies.json \
           usr/share/libalpm/hooks/lunar-librewolf-policies.hook; do
    install -Dm644 "$startdir/files/$f" "$pkgdir/$f"
  done
  install -Dm755 "$startdir/files/usr/lib/lunar/librewolf-policies" \
    "$pkgdir/usr/lib/lunar/librewolf-policies"
}
