# Maintainer: Timon <timon2201@gmail.com>
#
# Ananicy Configurator - Qt GUI to edit the ananicy-cpp types, rules and
# ananicy.conf in /etc/ananicy.d (saves through pkexec, restarts the service).
# Built from the release tag v$pkgver of github.com/WhitePeace36/AnanicyConfigurator
# (same build as the repo's own PKGBUILD, which builds a local checkout).
#
# To release a new version: tag it vX.Y.Z in the project's repo and push the
# tag, then set pkgver here to X.Y.Z and pkgrel to 1. For a change to this
# PKGBUILD only, raise pkgrel.

pkgname=ananicy-configurator
pkgver=1.0.1
pkgrel=1
pkgdesc='Qt GUI to edit ananicy / ananicy-cpp types, rules and ananicy.conf'
arch=('x86_64')
url='https://github.com/WhitePeace36/AnanicyConfigurator'
license=('GPL-2.0-only')
depends=('qt6-base' 'polkit' 'systemd' 'hicolor-icon-theme' 'gcc-libs' 'glibc')
makedepends=('git' 'cmake')
optdepends=('ananicy-cpp: the daemon this program configures')
source=("ac::git+${url}.git#tag=v${pkgver}")
sha256sums=('SKIP')


build() {
  cmake -S ac -B build \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -Wno-dev
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 ac/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 ac/README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
