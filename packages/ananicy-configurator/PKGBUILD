# Maintainer: Timon <timon2201@gmail.com>
#
# Ananicy Configurator - Qt GUI to edit the ananicy-cpp types, rules and
# ananicy.conf in /etc/ananicy.d (saves through pkexec, restarts the service).
# Built from github.com/WhitePeace36/AnanicyConfigurator at a pinned commit
# (same build as the repo's own PKGBUILD, which builds a local checkout).
#
# To update: set _commit to the new commit and reset pkgrel to 1.

pkgname=ananicy-configurator
_commit=0f4f7af25239fe8bc75a05b02f3a98bc1d88c820
pkgver=1.0.0.r0.g0f4f7af
pkgrel=1
pkgdesc='Qt GUI to edit ananicy / ananicy-cpp types, rules and ananicy.conf'
arch=('x86_64')
url='https://github.com/WhitePeace36/AnanicyConfigurator'
license=('GPL-2.0-only')
depends=('qt6-base' 'polkit' 'systemd' 'hicolor-icon-theme' 'gcc-libs' 'glibc')
makedepends=('git' 'cmake')
optdepends=('ananicy-cpp: the daemon this program configures')
source=("ac::git+${url}.git#commit=${_commit}")
sha256sums=('SKIP')

# same scheme as upstream: 1.0.0 on the v1.0.0 tag, 1.0.0.r<n>.g<hash> otherwise
pkgver() {
  cd ac
  local ver count
  ver=$(sed -n 's/^project([^)]*VERSION \([0-9.]*\).*/\1/p' CMakeLists.txt)
  if git tag --points-at HEAD | grep -qx "v$ver"; then
    printf '%s' "$ver"
    return
  fi
  if git rev-parse -q --verify "refs/tags/v$ver" >/dev/null; then
    count=$(git rev-list --count "v$ver..HEAD")
  else
    count=$(git rev-list --count HEAD)
  fi
  printf '%s.r%s.g%s' "$ver" "$count" "$(git rev-parse --short=7 HEAD)"
}

build() {
  cmake -S ac -B build \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -Wno-dev
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 ac/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 ac/README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
