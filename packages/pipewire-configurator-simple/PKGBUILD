# Maintainer: Timon <timon2201@gmail.com>
#
# PipewireSimpleConfigurator - GUI for PipeWire and WirePlumber settings.
# Built from the release tag v$pkgver of
# github.com/WhitePeace36/PipewireSimpleConfigurator (same build as the repo's
# own PKGBUILD, which builds a local checkout).
#
# To release a new version: tag it vX.Y.Z in the project's repo and push the
# tag, then set pkgver here to X.Y.Z and pkgrel to 1. For a change to this
# PKGBUILD only, raise pkgrel.

pkgname=pipewire-configurator-simple
pkgver=2.0.1
pkgrel=1
pkgdesc='GUI tool for PipeWire and WirePlumber settings'
arch=('x86_64')
url='https://github.com/WhitePeace36/PipewireSimpleConfigurator'
license=('GPL-2.0-only')
depends=('qt6-base' 'pipewire' 'wireplumber' 'hicolor-icon-theme' 'glibc' 'gcc-libs')
makedepends=('git' 'cmake')
optdepends=('pipewire-pulse: settings for applications that use the PulseAudio API'
            'pipewire-jack: settings for JACK applications')
provides=('pipewire-simple-configurator')
replaces=('pipewire-simple-configurator')
conflicts=('pipewire-simple-configurator')
source=("psc::git+${url}.git#tag=v${pkgver}")
sha256sums=('SKIP')

build() {
  cmake -S psc -B build \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -Wno-dev
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 psc/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
