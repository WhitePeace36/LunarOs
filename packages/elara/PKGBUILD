# Maintainer: Timon <timon2201@gmail.com>
#
# Elara - sched_ext scheduler that follows the nice values ananicy-cpp sets.
# Built from the release tag v$pkgver of github.com/WhitePeace36/Elara, with the
# repo's own CMake install rules (binary, elara.service, elara-hook) and
# its committed include/vmlinux.h (Linux 7.3+ types for the BPF part).
# To build against another vmlinux.h, set ELARA_VMLINUX_H=/path/to/vmlinux.h.
#
# To release a new version: tag it vX.Y.Z in the project's repo and push the
# tag, then set pkgver here to X.Y.Z and pkgrel to 1. For a change to this
# PKGBUILD only, raise pkgrel.

pkgname=elara
pkgver=1.0.0
pkgrel=1
pkgdesc='sched_ext CPU scheduler, tuned by nice values, for stable frame times'
arch=('x86_64')
url='https://github.com/WhitePeace36/Elara'
license=('GPL-2.0-only')
depends=('libbpf' 'glibc' 'gcc-libs')
makedepends=('git' 'cmake' 'clang' 'lld' 'bpf' 'pkgconf')
optdepends=('ananicy-cpp: sets the nice values Elara schedules by')
provides=('scx-elara')
replaces=('scx-elara')
conflicts=('scx-elara' 'scx-manager')
options=('!lto' '!debug')
install=elara.install
source=("elara::git+${url}.git#tag=v${pkgver}")
sha256sums=('SKIP')


prepare() {
  cd elara
  if [[ -n "${ELARA_VMLINUX_H:-}" ]]; then
    echo "==> vmlinux.h from \$ELARA_VMLINUX_H"
    cp "$ELARA_VMLINUX_H" include/vmlinux.h
  fi
  [[ -s include/vmlinux.h ]] || { echo "==> ERROR: include/vmlinux.h missing in the Elara repo" >&2; return 1; }
}

build() {
  cmake -S elara -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_C_COMPILER=clang \
    -DCMAKE_CXX_COMPILER=clang++ \
    -DELARA_NATIVE_ARCH=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 elara/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 elara/README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
