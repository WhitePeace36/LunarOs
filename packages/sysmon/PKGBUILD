# Maintainer: Timon <timon2201@gmail.com>
#
# Sysmon - Lunar's system monitor (performance graphs, processes, systemd
# services). Built from the release tag v$pkgver of github.com/WhitePeace36/Sysmon
# (same build as the repo's own PKGBUILD, which builds a local checkout).
#
# Lunar installs it instead of KDE's plasma-systemmonitor and starts it with
# Ctrl+Shift+Esc: package() adds X-KDE-Shortcuts to sysmon.desktop, which
# Plasma (kglobalacceld) registers as the default global shortcut of the
# application. Users change it in System Settings > Keyboard > Shortcuts.
#
# To release a new version: tag it vX.Y.Z in the project's repo and push the
# tag, then set pkgver here to X.Y.Z and pkgrel to 1. For a change to this
# PKGBUILD only, raise pkgrel.

pkgname=sysmon
pkgver=1.0.0
pkgrel=1
pkgdesc='System monitor with performance graphs, process lists and systemd services'
arch=('x86_64')
url='https://github.com/WhitePeace36/Sysmon'
license=('GPL-2.0-only')
depends=('qt6-base' 'gcc-libs' 'glibc' 'hicolor-icon-theme')
makedepends=('git' 'cmake')
optdepends=('polkit: signal processes and manage services that need administrator rights'
            'hwdata: GPU model names'
            'nvidia-utils: NVIDIA GPU statistics')
source=("sysmon::git+${url}.git#tag=v${pkgver}")
sha256sums=('SKIP')

_shortcut='Ctrl+Shift+Esc'

build() {
  cmake -S sysmon -B build \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -Wno-dev
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  local desktop="$pkgdir/usr/share/applications/sysmon.desktop"
  sed -i '/^X-KDE-Shortcuts=/d' "$desktop"
  sed -i "/^\[Desktop Entry\]\$/a X-KDE-Shortcuts=$_shortcut" "$desktop"
  grep -q "^X-KDE-Shortcuts=$_shortcut\$" "$desktop"
}
