# Maintainer: Timon <timon2201@gmail.com>
#
# Pipewire Configurator - GUI for PipeWire and WirePlumber settings.
# Built from the release tag v$pkgver of
# github.com/WhitePeace36/PipewireConfigurator (same build as the repo's own
# PKGBUILD, which builds a local checkout). Called pipewire-configurator-simple
# up to 2.0.x, and pipewire-simple-configurator before that.
#
# To release a new version: tag it vX.Y.Z in the project's repo and push the
# tag, then set pkgver here to X.Y.Z and pkgrel to 1. For a change to this
# PKGBUILD only, raise pkgrel.

pkgname=pipewire-configurator
pkgver=2.2.0
pkgrel=1
pkgdesc='GUI tool for PipeWire and WirePlumber settings'
arch=('x86_64')
url='https://github.com/WhitePeace36/PipewireConfigurator'
license=('GPL-2.0-only')
depends=('qt6-base' 'pipewire' 'wireplumber' 'hicolor-icon-theme' 'glibc' 'gcc-libs')
makedepends=('git' 'cmake')
optdepends=('pipewire-pulse: settings for applications that use the PulseAudio API'
            'pipewire-jack: settings for JACK applications')
provides=('pipewire-configurator-simple' 'pipewire-simple-configurator')
replaces=('pipewire-configurator-simple' 'pipewire-simple-configurator')
conflicts=('pipewire-configurator-simple' 'pipewire-simple-configurator')
source=("pwc::git+${url}.git#tag=v${pkgver}")
sha256sums=('SKIP')

build() {
  cmake -S pwc -B build \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -Wno-dev
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 pwc/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
