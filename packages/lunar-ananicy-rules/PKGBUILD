# Maintainer: Timon <timon2201@gmail.com>
#
# Timon's ananicy-cpp rules for Lunar: everything under ananicy.d/ in
# github.com/WhitePeace36/ananicy-rules goes to /etc/ananicy.d/ with the same
# layout (ananicy.conf, 99-types.types, 99-rules/*.rules).
#
# To release a new version: tag it vX.Y.Z in the project's repo and push the
# tag, then set pkgver here to X.Y.Z and pkgrel to 1. For a change to this
# PKGBUILD only, raise pkgrel.

pkgname=lunar-ananicy-rules
pkgver=1.0.0
pkgrel=1
pkgdesc='Lunar - ananicy-cpp rules tuned for the Elara scheduler'
arch=('any')
url='https://github.com/WhitePeace36/ananicy-rules'
license=('GPL-2.0-only')
makedepends=('git')
provides=('ananicy-rules')
conflicts=('ananicy-rules' 'ananicy-rules-git' 'ananicy-cpp-rules' 'ananicy-rules-custom')
backup=('etc/ananicy.d/ananicy.conf')
source=("rules::git+${url}.git#tag=v${pkgver}")
sha256sums=('SKIP')


check() {
  [ -f rules/ananicy.d/ananicy.conf ] || { echo "ananicy.d/ananicy.conf missing in the rules repo" >&2; return 1; }
}

package() {
  local src=rules/ananicy.d dest="$pkgdir/etc/ananicy.d" f
  install -dm755 "$dest"
  while IFS= read -r -d '' f; do
    f="${f#"$src"/}"
    [ "$f" = LICENSE ] && continue
    install -Dm644 "$src/$f" "$dest/$f"
  done < <(find "$src" -type f -print0)
  install -Dm644 "$src/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
